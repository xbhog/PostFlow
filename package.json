{
  "name": "draftdock",
  "private": false,
  "version": "0.4.0",
  "packageManager": "pnpm@10.30.3",
  "description": "A local-first AI writing and publishing workspace for WeChat Official Accounts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xbhog/draftdock.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "start:desktop": "electron .",
    "build": "tsc -b && vite build",
    "build:desktop": "pnpm build && electron-builder",
    "release:check": "node scripts/check-release-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "concurrently -k -s command-1 \"vite --host 127.0.0.1 --port 4173 --strictPort\" \"wait-on http://127.0.0.1:4173 && playwright test\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@types/turndown": "^5.0.6",
    "framer-motion": "^11.11.11",
    "highlight.js": "^11.10.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.460.0",
    "markdown-it": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "7.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.58.2",
    "@types/highlight.js": "^10.1.0",
    "@types/html2pdf.js": "^0.10.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^4.0.18",
    "wait-on": "^8.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.draftdock.app",
    "productName": "DraftDock",
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
